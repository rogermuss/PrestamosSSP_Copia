generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model category {
  id       Int        @id @default(autoincrement())
  name     String
  slug     String
  material material[]
}

model material {
  id             Int              @id @default(autoincrement())
  name           String           @unique(map: "Material_name_key")
  description    String?
  image          String
  categoryId     Int
  category       category         @relation(fields: [categoryId], references: [id], map: "Material_categoryId_fkey")
  variants materialvariant[]

  @@index([categoryId], map: "Material_categoryId_idx")
}

model materialvariant {
  id Int  @id @default(autoincrement())
  materialId Int
  specification String 
  stock Int
  totalStock Int
  
  material material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  requestproduct requestproduct[]
  
  @@index([materialId])
}

model materialrequest {
  id             Int              @id @default(autoincrement())
  requesterName  String
  totalItems     Int
  requestedAt    DateTime         @default(now())
  isCompleted    Boolean          @default(false)
  completedAt    DateTime?
  userId         Int              @default(1)
  user           user             @relation(fields: [userId], references: [id], map: "MaterialRequest_userId_fkey")
  requestproduct requestproduct[]

  @@index([userId], map: "MaterialRequest_userId_idx")
}

model requestproduct {
  id              Int             @id @default(autoincrement())
  requestId       Int
  variantId       Int
  quantity        Int

  materialrequest materialrequest @relation(fields: [requestId], references: [id], map: "RequestProduct_requestId_fkey")
  variant         materialvariant @relation(fields: [variantId], references: [id])
  
  @@index([variantId], map: "RequestProduct_materialId_idx")
  @@index([requestId], map: "RequestProduct_requestId_idx")
}

model user {
  id              Int               @id @default(autoincrement())
  email           String            @unique(map: "User_email_key")
  name            String
  createdAt       DateTime          @default(now())
  materialrequest materialrequest[]
}
